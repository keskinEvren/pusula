# Pusula Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Arka Plan İşlemleri ve Cron Güvenliği
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
CRON_SECRET=your-cron-secret-key-here

# Web Push (VAPID) Anahtarları (npx web-push generate-vapid-keys ile üretilir)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:senin-adresin@gmail.com

# Ücretsiz SMTP (Nodemailer - Gmail App Password veya Özel SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=senin-adresin@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM="Pusula Kokpit <senin-adresin@gmail.com>"

# Uygulama Baz URL'i (E-posta ve Push yönlendirmeleri için)
NEXT_PUBLIC_APP_URL=http://localhost:3000
